 "deterministic": "no timestamps, no environment capture; two runs are byte-identical",
 "method": {
  "retiming": "frozen-composition retiming with the runner's own functions (silicon_anchor_runner.recover_membership / retime / request_delays / pct / Piecewise / aic_curve), loaded through an importlib spec shim. Batch order, recovered membership and the worker schedule are held fixed; only per-batch SERVICE TIME changes.",
  "stored_sim_p99": "banked simulator encoder-delay p99 from simulation/silicon_anchor_queue.json cells[cid].banked.encoder_delay_ms.p99; re-derived here by retiming under the simulator's own per-batch service times (reconstruction gate: max batch-finish deviation <= 1e-6 ms AND replayed p99 == banked p99).",
  "direct_vllm_p99": "per-batch service := vllm_mean_ms(N) for that batch's image count N, taken from the dense vLLM sweep (mean_ms field) via runner.Piecewise. Every dispatched N is an exact dense-table key (N=1..64), so no interpolation is exercised.",
  "per_n_scaled_p99": "per-batch service := sim_service_ms * (vllm_mean_ms(N) / aic_ms(N)), with aic_ms = runner.aic_curve() over collector_artifacts/phaseB_batch_validation/aic_f_n_postinfill.csv. Preserves the simulator's own per-batch service variation, re-levelled to the measured engine.",
  "percentile_convention": "runner.pct: sorted[min(len-1, int(len*p/100))] over ALL window requests, text-only requests contributing 0 (request_delays pads to n_all_requests); rounded to 3 dp.",
  "handoff_term": "request_delays adds the simulator's own handoff term rtt + (196*N*4096*2)*8/(gbps*1e9)*1e3 with the dispatch's banked rtt/gbps, identically in every representation.",
  "sla_bound_ms": 1000.0
 },
