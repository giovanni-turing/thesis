# latexmk config for the IME-USP thesis build (run from tex/): `latexmk` suffices.
# Derived from the model's latexmkrc (../template/modelo-latex/latexmkrc),
# trimmed to what this build actually needs:
#   * no biber/bibtex run  -- the bibliography is a manual `thebibliography`
#   * no makeindex run     -- the text uses no \index
#   * no texlogsieve block -- that helper is not vendored here

@default_files = ('tese');

# TeXLive <= 2024 emits PDF 1.5; embedded figure PDFs are newer, which
# produces a warning. bxpdfver bumps the output to 1.7 (model's approach).
set_tex_cmds('-synctex=1 -halt-on-error -jobname=%A %O %P');
$pre_tex_code = '\RequirePackage[1.7]{bxpdfver}';

$pdf_mode = 1;
$postscript_mode = $dvi_mode = 0;

$silent = 1; # This adds "-interaction batchmode"
$silence_logfile_warnings = 1;
$rc_report = 0;

# Make latexmk -c/-C clean *all* generated files
$cleanup_includes_generated = 1;
$cleanup_includes_cusdep_generated = 1;

# https://tex.stackexchange.com/a/384153
$ENV{max_print_line} = $log_wrap = 100000;
$ENV{error_line} = 254;
$ENV{half_error_line} = 238;
